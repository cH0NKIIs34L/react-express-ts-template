# ===== server/.env =====

# --- Execution Environment ---
# Controls app behavior (logging, error detail)
# Options: development, test, production
NODE_ENV=development

# --- Network Configuration ---
SERVER_PORT=3000

# --- CORS ---
# Authorized frontend origins. Comma-separated, no spaces.
CORS_ALLOWED_ORIGINS=http://localhost:5173


# ===== server/.env.test =====

NODE_ENV=test
SERVER_PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:5173
